{
  "name": "vibeproof",
  "version": "0.3.0",
  "private": true,
  "description": "Scanner for vibe-coded web apps: secrets, Supabase RLS, client-side key exposure. University project.",
  "type": "module",
  "bin": {
    "vibeproof": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node lab/demo.mjs",
    "scan:repo": "node dist/cli.js repo",
    "scan:web": "node dist/cli.js web",
    "dashboard": "npm run build && node dist/cli.js dashboard"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.13.4",
    "typescript": "^5.6.3"
  }
}
